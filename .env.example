# ============================================================================
# STAYNEXA ENVIRONMENT CONFIGURATION
# ============================================================================

# Application Mode: 'demo' (default, in-memory isolated mock data) or 'production' (connected Supabase)
VITE_APP_MODE=demo

# Supabase Credentials (Required only for Connected / Production Mode)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Optional Public Base Domain for Tenant Subdomains
VITE_PUBLIC_DOMAIN=staynexa.com

# Integrations (Manual Mode / Unconnected in V1 until credentials provided)
# META WhatsApp Business API
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# External Channel Manager API
CHANNEL_MANAGER_ENDPOINT=
CHANNEL_MANAGER_API_KEY=
